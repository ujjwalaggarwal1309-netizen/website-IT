{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "name": "Primary", "color": "#1B4DDB" },
        { "slug": "primary-dark", "name": "Primary Dark", "color": "#0D2665" },
        { "slug": "primary-light", "name": "Primary Light", "color": "#E8F0FE" },
        { "slug": "accent", "name": "Accent", "color": "#F58220" },
        { "slug": "accent-hover", "name": "Accent Hover", "color": "#E06D10" },
        { "slug": "background-white", "name": "Background White", "color": "#FFFFFF" },
        { "slug": "background-light", "name": "Background Light", "color": "#F5F7FA" },
        { "slug": "heading", "name": "Heading", "color": "#0D2665" },
        { "slug": "body", "name": "Body Text", "color": "#4A4A68" },
        { "slug": "border", "name": "Border", "color": "#E0E4EC" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "Inter, sans-serif", "name": "Inter", "slug": "inter" }
      ],
      "fontSizes": [
        { "name": "Hero H1", "slug": "hero-h1", "size": "3rem" },
        { "name": "Section Heading", "slug": "section-heading", "size": "2.25rem" },
        { "name": "Card Heading", "slug": "card-heading", "size": "1.375rem" },
        { "name": "Subtitle", "slug": "subtitle", "size": "1.125rem" },
        { "name": "Body", "slug": "body", "size": "1rem" },
        { "name": "Small", "slug": "small", "size": "0.875rem" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1320px"
    },
    "border": {
      "radius": true
    }
  },
  "styles": {
    "elements": {
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "fontWeight": "800" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "fontWeight": "700" } },
      "link": { "color": { "text": "#1B4DDB" } }
    },
    "blocks": {
      "core/button": {
        "border": { "radius": "8px" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--inter)" }
      }
    }
  }
}
