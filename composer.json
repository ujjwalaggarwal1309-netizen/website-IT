{
    "name": "infinityitsolutions/theme",
    "description": "Infinity IT Solutions WordPress Theme",
    "type": "wordpress-theme",
    "require": {
        "php": ">=8.0",
        "phpoffice/phpspreadsheet": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "ITHS\\Import\\": "inc/import/"
        }
    },
    "config": {
        "vendor-dir": "inc/vendor",
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
